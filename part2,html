function checkLesson(topic) {

  const lesson = getLessonData(topic);

  let score = 0;


  lesson.questions.forEach((q, i) => {

    const input =
      document.getElementById(
        `lessonAnswer${i}`
      );

    const answer =
      document.getElementById(
        `lessonCorrect${i}`
      );


    const user =
      input.value
        .trim()
        .toLowerCase();


    const correct =
      String(q[1])
        .trim()
        .toLowerCase();


    if (user === correct) {

      score++;

    }


    answer.style.display = "block";

  });


  if (
    score === lesson.questions.length &&
    !completed.includes(topic)
  ) {

    completed.push(topic);

    saveData();

  }


  document.getElementById(
    "lessonScore"
  ).innerHTML = `

    <div class="card" style="margin-top:15px">

      <h3>
        Score: ${score}/${lesson.questions.length}
      </h3>

      <p class="small">

        ${
          score === 5
            ? "🔥 Perfect! You smashed it."
            : score >= 3
            ? "👍 Good work. Review the examples and try again."
            : "📚 Go back through the explanation and examples."
        }

      </p>

    </div>

  `;

}


function completeTopic(topic) {

  if (!completed.includes(topic)) {

    completed.push(topic);

    saveData();

  }

  openTopic(topic);

}


function tutorHelp(topic) {

  const userQuestion =
    document
      .getElementById("tutorQuestion")
      .value
      .trim();


  const lesson =
    getLessonData(topic);


  const reply =
    userQuestion

    ? `
      Let's slow it down.

      <br><br>

      First remember:

      <strong>
        ${lesson.rules[0]}
      </strong>

      <br><br>

      Now look at Example 1.
      Don't worry about the final answer yet.
      Try to identify the first step the example takes.

      <br><br>

      You said:
      "${userQuestion}"
    `

    : `
      Here's a hint:

      <br><br>

      <strong>
        ${lesson.rules[0]}
      </strong>

      <br><br>

      Start with Example 1 and try to copy
      the method rather than the numbers.
    `;


  document.getElementById(
    "tutorReply"
  ).innerHTML = `

    <div class="card" style="margin-top:15px">

      🤖 <strong>MathSprint Tutor</strong>

      <p
        class="small"
        style="margin-top:10px"
      >
        ${reply}
      </p>

    </div>

  `;

}

