function getLessonData(topic) {

  if (lessonData[topic]) {
    return lessonData[topic];
  }

  return {
    explanation:
      `${topic} will have a full lesson here. Start by identifying what the question is asking and matching it to the correct mathematical method.`,

    rules: [
      "Read the question carefully.",
      "Choose the correct method.",
      "Show your working and check your answer."
    ],

    examples: [
      {
        question: "Starter example",
        working: "Identify the information given, choose the correct rule, then work through the calculation step by step."
      },
      {
        question: "Exam-style example",
        working: "Underline the important information, write down your method and check the final answer."
      },
      {
        question: "Challenge example",
        working: "Break the problem into smaller steps and check each step as you go."
      }
    ],

    mistakes: [
      "Using a method without checking that it fits the question.",
      "Skipping working and losing track of the calculation."
    ],

    questions: [
      ["Practice question 1", "See lesson explanation"],
      ["Practice question 2", "See lesson explanation"],
      ["Practice question 3", "See lesson explanation"],
      ["Practice question 4", "See lesson explanation"],
      ["Practice question 5", "See lesson explanation"]
    ]
  };
}


